<MudDialog>
    <TitleContent>
        <div class="entity-dialog-title">
            <MudIcon Icon="@Icon" Color="@IconColor" />
            <MudText Typo="Typo.h6">@Title</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <Condition Value="!Found">
            <MudAlert Severity="Severity.Warning">エンティティが見つかりません（削除された可能性があります）。</MudAlert>
        </Condition>
        <Condition Value="Found">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@EntityId</MudText>
            <MudTabs Elevation="0" TabPanelsClass="pt-4">
                <MudTabPanel Text="操作">
                    <MudText Typo="Typo.h5" Class="mb-4">@StateText</MudText>
                    <Condition Value="IsToggle">
                        <MudSwitch T="bool" Value="IsOn" ValueChanged="OnSwitchChanged" Color="Color.Primary" Disabled="!Available" Label="オン / オフ" />
                    </Condition>
                    <Condition Value="ShowBrightness">
                        <MudText Typo="Typo.body2" Class="mt-4">明るさ: @BrightnessText</MudText>
                        <MudSlider T="int" Value="BrightnessPercent" ValueChanged="OnBrightnessChanged" Min="1" Max="100" Step="1" Immediate="false" Disabled="!Available" Color="Color.Warning" />
                    </Condition>
                    <Condition Value="IsButton">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.TouchApp" Disabled="!Available" OnClick="OnPressClick">押す</MudButton>
                    </Condition>
                    <Condition Value="IsNumber">
                        <MudSlider T="double" Value="NumberValue" ValueChanged="OnNumberChanged" Min="NumberMin" Max="NumberMax" Step="NumberStep" Immediate="false" ValueLabel="true" Disabled="!Available" />
                        <div class="entity-dialog-range">
                            <MudText Typo="Typo.caption">@NumberMinText</MudText>
                            <MudText Typo="Typo.caption">@NumberMaxText</MudText>
                        </div>
                    </Condition>
                    <Condition Value="IsSelect">
                        <MudSelect T="string" Value="CurrentOption" ValueChanged="OnOptionChanged" Label="選択" Variant="Variant.Outlined" Disabled="!Available">
                            <ListItem Items="Options" Context="option">
                                <ItemTemplate>
                                    <MudSelectItem Value="option">@option</MudSelectItem>
                                </ItemTemplate>
                            </ListItem>
                        </MudSelect>
                    </Condition>
                </MudTabPanel>
                <MudTabPanel Text="属性">
                    <MudSimpleTable Dense="true" Class="entity-attributes">
                        <thead>
                            <tr>
                                <th>名前</th>
                                <th>値</th>
                            </tr>
                        </thead>
                        <tbody>
                            <ListItem Items="AttributeList" Context="item">
                                <ItemTemplate>
                                    <tr>
                                        <td>@item.Key</td>
                                        <td>@JsonFormatter.FormatValue(item.Value)</td>
                                    </tr>
                                </ItemTemplate>
                            </ListItem>
                        </tbody>
                    </MudSimpleTable>
                </MudTabPanel>
            </MudTabs>
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.body2">🕒 最終変更: @LastChangedText</MudText>
            <MudText Typo="Typo.body2">🔄 最終更新: @LastUpdatedText</MudText>
            <MudText Typo="Typo.body2">👤 操作: @UserText</MudText>
        </Condition>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="OnCloseClick">閉じる</MudButton>
    </DialogActions>
</MudDialog>
