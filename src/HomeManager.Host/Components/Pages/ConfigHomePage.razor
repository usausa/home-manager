@page "/config"
@attribute [Authorize(Policy = Policies.Administrator)]

<PageTitle>設定</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">⚙️ 設定</MudText>

<MudGrid Spacing="3">
    <ListItem Items="Menus" Context="menu">
        <ItemTemplate>
            <MudItem xs="12" sm="6" md="4">
                <a href="@menu.Href" class="config-menu">
                    <MudPaper Outlined="true" Class="pa-4 config-menu-body">
                        <MudText Typo="Typo.h6">@menu.Title</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@menu.Description</MudText>
                    </MudPaper>
                </a>
            </MudItem>
        </ItemTemplate>
    </ListItem>
</MudGrid>
