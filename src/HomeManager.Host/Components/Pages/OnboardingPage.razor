@page "/onboarding"
@attribute [Authorize]
@layout PlainLayout

<PageTitle>初回セットアップ</PageTitle>

<MudPaper Class="onboarding-card pa-8 mx-auto mt-16">
    <MudText Typo="Typo.h5" Class="mb-1">🚀 HomeManager へようこそ</MudText>
    <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">使い始める前に、次の設定をしてください。</MudText>

    <div class="onboarding-steps mb-6">
        <ListItem Items="steps" Context="item">
            <ItemTemplate>
                <MudChip T="string" Size="Size.Small" Color="GetStepColor(item)" Variant="GetStepVariant(item)">@GetStepTitle(item)</MudChip>
            </ItemTemplate>
        </ListItem>
    </div>

    <Condition Value="IsPasswordStep">
        <MudText Typo="Typo.h6">🔑 パスワードの変更</MudText>
        <MudText Typo="Typo.body2" Class="mb-2 mud-text-secondary">初期パスワードのままでは使えません。@Length.PasswordMin 文字以上の新しいパスワードに変えてください。</MudText>
        <MudForm @ref="passwordForm" Spacing="2">
            <MudTextField T="string" @bind-Value="currentPassword" Label="今のパスワード" InputType="InputType.Password" Required="true" RequiredError="今のパスワードを入力してください。" MaxLength="@Length.Password" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudTextField T="string" @bind-Value="newPassword" Label="新しいパスワード" InputType="InputType.Password" Validation="@(new Func<string?, string?>(AccountRules.ValidatePassword))" MaxLength="@Length.Password" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudTextField T="string" @bind-Value="confirmPassword" Label="新しいパスワード（確認）" InputType="InputType.Password" Validation="@(new Func<string?, string?>(ValidateConfirm))" MaxLength="@Length.Password" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudForm>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward" Disabled="busy" Class="mt-4" OnClick="OnPasswordSubmitAsync">変更して次へ</MudButton>
    </Condition>

    <Condition Value="IsCoreConfigStep">
        <MudText Typo="Typo.h6">🏠 家の情報</MudText>
        <MudText Typo="Typo.body2" Class="mb-2 mud-text-secondary">あとから「設定 → 全体設定」で変えられます。</MudText>
        <CoreConfigForm @ref="configForm" Model="configModel" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward" Disabled="busy" Class="mt-4" OnClick="OnCoreConfigSubmitAsync">保存して次へ</MudButton>
    </Condition>

    <Condition Value="IsDoneStep">
        <MudText Typo="Typo.h6">🎉 準備ができました</MudText>
        <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">概要の画面で、家の機器の状態を見たり操作したりできます。</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Home" OnClick="OnStartClick">はじめる</MudButton>
    </Condition>
</MudPaper>
