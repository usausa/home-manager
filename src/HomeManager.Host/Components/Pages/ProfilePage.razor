@page "/profile"
@attribute [Authorize]

<PageTitle>プロフィール</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">👤 プロフィール</MudText>

<Condition Value="!Found">
    <MudAlert Severity="Severity.Warning">ユーザーが見つかりません。もう一度ログインしてください。</MudAlert>
</Condition>

<Condition Value="Found">
    <MudPaper Outlined="true" Class="pa-4 mb-4 settings-section">
        <MudText Typo="Typo.h6">基本情報</MudText>
        <MudText Typo="Typo.body2" Class="mb-2 mud-text-secondary">ログイン ID: @LoginName ／ ロール: @RoleName</MudText>
        <MudForm @ref="profileForm">
            <MudTextField T="string"
                          @bind-Value="displayName"
                          Label="表示名"
                          HelperText="上部バーに出ます"
                          MaxLength="@Length.Name"
                          Validation="@(new Func<string?, string?>(AccountRules.ValidateDisplayName))"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />
        </MudForm>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Disabled="busy" Class="mt-4" OnClick="OnProfileSaveAsync">保存</MudButton>
    </MudPaper>

    <MudPaper Outlined="true" Class="pa-4 mb-4 settings-section">
        <MudText Typo="Typo.h6">テーマ</MudText>
        <MudText Typo="Typo.body2" Class="mb-2 mud-text-secondary">選ぶとすぐに変わります。</MudText>
        <MudRadioGroup T="string" Value="theme" ValueChanged="OnThemeChangedAsync" Disabled="busy">
            <MudRadio T="string" Value="ThemeModes.Light">ライト</MudRadio>
            <MudRadio T="string" Value="ThemeModes.Dark">ダーク</MudRadio>
            <MudRadio T="string" Value="ThemeModes.Auto">自動（OS の設定に合わせる）</MudRadio>
        </MudRadioGroup>
    </MudPaper>

    <MudPaper Outlined="true" Class="pa-4 settings-section">
        <MudText Typo="Typo.h6">パスワードの変更</MudText>
        <MudText Typo="Typo.body2" Class="mb-2 mud-text-secondary">@Length.PasswordMin 文字以上で、今のパスワードと違うものにしてください。</MudText>
        <PasswordChangeForm @ref="passwordForm" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Key" Disabled="busy" Class="mt-4" OnClick="OnPasswordChangeAsync">変更</MudButton>
    </MudPaper>
</Condition>
