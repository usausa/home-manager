<MudForm @ref="form" Spacing="2">
    <MudTextField T="string" @bind-Value="CurrentPassword" Label="今のパスワード" InputType="InputType.Password" Required="true" RequiredError="今のパスワードを入力してください。" MaxLength="@Length.Password" Variant="Variant.Outlined" Margin="Margin.Dense" />
    <MudTextField T="string" @bind-Value="NewPassword" Label="新しいパスワード" InputType="InputType.Password" Validation="@(new Func<string?, string?>(AccountRules.ValidatePassword))" MaxLength="@Length.Password" Variant="Variant.Outlined" Margin="Margin.Dense" />
    <MudTextField T="string" @bind-Value="confirmPassword" Label="新しいパスワード（確認）" InputType="InputType.Password" Validation="@(new Func<string?, string?>(ValidateConfirm))" MaxLength="@Length.Password" Variant="Variant.Outlined" Margin="Margin.Dense" />
</MudForm>
