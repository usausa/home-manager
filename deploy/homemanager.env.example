# /etc/homemanager/homemanager.env に置く（所有者 root・パーミッション 600）
# appsettings.json の値を環境変数で上書きする（区切りは __）
# DB は SQLite のファイル（/var/lib/homemanager は systemd の StateDirectory が作る）
ConnectionStrings__Default=Data Source=/var/lib/homemanager/homemanager.db;Foreign Keys=True
Auth__InitialAccount__Password=change-me
